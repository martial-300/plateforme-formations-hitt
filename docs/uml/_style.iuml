' Style commun aux diagrammes HIT-T (couleurs du logo, sobre)
skinparam shadowing false
skinparam defaultFontName "IBM Plex Sans"
skinparam defaultFontSize 13
skinparam defaultFontColor #1D1D1B
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #146B47
skinparam ArrowFontColor #4A4844
skinparam ArrowFontSize 11
skinparam roundCorner 4
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #BDB6A8
skinparam NoteFontColor #4A4844
skinparam actorBorderColor #146B47
skinparam actorBackgroundColor #FFFFFF
skinparam usecaseBorderColor #146B47
skinparam usecaseBackgroundColor #FFFFFF
skinparam rectangleBorderColor #BDB6A8
skinparam classBorderColor #146B47
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #EEF5F0
skinparam classAttributeIconSize 0
skinparam sequenceParticipantBorderColor #146B47
skinparam sequenceParticipantBackgroundColor #FFFFFF
skinparam sequenceLifeLineBorderColor #BDB6A8
skinparam sequenceGroupBorderColor #BDB6A8
skinparam sequenceGroupHeaderFontColor #146B47
skinparam sequenceBoxBorderColor #DCD7CC
skinparam sequenceBoxBackgroundColor #F6F4EF
skinparam activityBorderColor #146B47
skinparam activityBackgroundColor #FFFFFF
skinparam activityDiamondBorderColor #146B47
skinparam activityDiamondBackgroundColor #FFFFFF
skinparam activityStartColor #146B47
skinparam activityEndColor #146B47
skinparam swimlaneBorderColor #DCD7CC
skinparam stateBorderColor #146B47
skinparam stateBackgroundColor #FFFFFF
skinparam nodeBorderColor #146B47
skinparam nodeBackgroundColor #FFFFFF
skinparam componentBorderColor #146B47
skinparam componentBackgroundColor #FFFFFF
skinparam databaseBorderColor #146B47
skinparam databaseBackgroundColor #FFFFFF
skinparam cloudBorderColor #BDB6A8
