# Copier en .env et adapter. Ne jamais committer le fichier .env.

# PostgreSQL
POSTGRES_DB=hitt
POSTGRES_USER=hitt
POSTGRES_PASSWORD=changer-moi

# Backend
DATABASE_URL=postgresql+psycopg://hitt:changer-moi@localhost:5432/hitt
JWT_SECRET=generer-avec-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173
# Proxys dont uvicorn accepte X-Forwarded-For (sous-réseaux Docker, où se trouve nginx).
# Ne jamais mettre * : n'importe qui pourrait alors choisir son adresse IP.
FORWARDED_ALLOW_IPS=172.16.0.0/12
# Connexion avec Google (RF-13) : identifiant client OAuth créé dans Google Cloud Console
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Compte administrateur créé au démarrage s'il n'existe pas
ADMIN_EMAIL=admin@hitt.demo
ADMIN_PASSWORD=changer-moi
ADMIN_NOM=Admin
ADMIN_PRENOM=HIT-T

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Production
DOMAINE=exemple.com
