# Copier en .env et adapter. Ne jamais committer le fichier .env.

# PostgreSQL
POSTGRES_DB=hitt
POSTGRES_USER=hitt
POSTGRES_PASSWORD=changer-moi

# Backend
DATABASE_URL=postgresql+psycopg://hitt:changer-moi@localhost:5432/hitt
JWT_SECRET=generer-avec-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173
# Tests (facultatif) : base du service db-test, valeur par défaut ci-dessous
# TEST_DATABASE_URL=postgresql+psycopg://test:test@localhost:55432/hitt_test
# Proxys dont uvicorn accepte X-Forwarded-For : fixé dans docker-compose.yml à l'adresse de
# nginx (NGINX_IP ci-dessous), à ne pas définir ici. Ne jamais mettre *.
# Connexion avec Google (RF-13) : identifiant client OAuth créé dans Google Cloud Console
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Compte administrateur créé au démarrage s'il n'existe pas (aucun si ADMIN_EMAIL est vide).
# ADMIN_PASSWORD : 8 caractères à 72 octets, et différent de la valeur ci-dessous, sinon l'API refuse de démarrer.
ADMIN_EMAIL=admin@hitt.demo
ADMIN_PASSWORD=changer-moi
ADMIN_NOM=Admin
ADMIN_PRENOM=HIT-T

# Frontend (intégrées au build). En production : VITE_API_URL=/api/v1 (même domaine que le site).
VITE_API_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Production (docs/deploiement.md). Penser aussi à CORS_ORIGINS=https://<DOMAINE>.
# Domaine du site, remplacé dans deploy/nginx.conf ; certificat demandé pour lui.
DOMAINE=exemple.com
# Adresse qui reçoit les avis d'expiration de Let's Encrypt (deploy/premier-certificat.sh).
CERTBOT_EMAIL=admin@exemple.com
# Mot de passe commun des comptes de démo, passé à `python -m app.outils.comptes_demo`.
DEMO_MOT_DE_PASSE=changer-moi-aussi
# Facultatif : ports de nginx (80 et 443 par défaut) pour une répétition en local, et réseau
# Docker de production si 172.30.89.0/24 est déjà pris sur le serveur.
# HTTP_PORT=8080
# HTTPS_PORT=8443
# RESEAU_PRODUCTION=172.30.89.0/24
# NGINX_IP=172.30.89.10
